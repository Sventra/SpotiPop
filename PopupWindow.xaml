<Window x:Class="SpotiPop.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotiPop" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal" RenderOptions.ClearTypeHint="Enabled">


    <!-- Outer margin leaves room for the drop shadow -->
    <Grid x:Name="Root" Margin="64" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0"/>
        </Grid.RenderTransform>

        <!-- Translucent glass card; the glow (bloom) around it takes its colour from the album art -->
        <Border Width="360" CornerRadius="28" Background="#8F0C0C0E" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#55FFFFFF" Offset="0"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.6"/>
                    <GradientStop Color="#33FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="CardGlow" BlurRadius="60" ShadowDepth="0" Opacity="0.55" Color="#1ED760"/>
            </Border.Effect>

            <Grid>
                <!-- Ambient colour wash -->
                <Border CornerRadius="28" Opacity="0.38" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.1,0.05" GradientOrigin="0.1,0.05" RadiusX="1.1" RadiusY="0.9">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Border Padding="20">
            <StackPanel>
                <!-- Track info -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ArtBorder" Width="92" Height="92" CornerRadius="18" Background="#33FFFFFF">
                        <Border.Effect>
                            <DropShadowEffect x:Name="ArtGlow" BlurRadius="32" ShadowDepth="0" Opacity="0.75" Color="#1ED760"/>
                        </Border.Effect>
                        <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource Icons}"
                                   FontSize="32" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NOW PLAYING" FontSize="11" FontFamily="{StaticResource UiFontMedium}" Foreground="#77FFFFFF" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TitleText" FontSize="19" FontFamily="{StaticResource UiFontMedium}" Foreground="White"
                                   TextTrimming="CharacterEllipsis" MaxHeight="52" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ArtistText" FontSize="14" Foreground="#99FFFFFF" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Transport -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Style="{StaticResource RoundButton}" Content="&#xE892;" Click="Previous_Click" ToolTip="Previous"/>
                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Content="&#xE769;" Margin="14,0" Click="Play_Click">
                        <Button.Effect>
                            <DropShadowEffect x:Name="PlayGlow" BlurRadius="26" ShadowDepth="0" Opacity="0.8" Color="#1ED760"/>
                        </Button.Effect>
                    </Button>
                    <Button Style="{StaticResource RoundButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Next"/>
                </StackPanel>

                <!-- Volume -->
                <Grid Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="Volume" FontSize="13" Foreground="#99FFFFFF" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="VolumeText" Text="0%" FontSize="13" Foreground="White" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource RoundButton}" Width="36" Height="36" FontSize="14" Content="&#xE738;" Click="VolumeDown_Click"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource PillSlider}" Margin="10,0"
                            ValueChanged="Volume_Changed" PreviewMouseWheel="Volume_Wheel"/>
                    <Button Grid.Column="2" Style="{StaticResource RoundButton}" Width="36" Height="36" FontSize="14" Content="&#xE710;" Click="VolumeUp_Click"/>
                </Grid>
            </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
