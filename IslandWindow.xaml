<Window x:Class="SpotiPop.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotiPop island" Width="540" Height="210" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal" RenderOptions.ClearTypeHint="Enabled">

    <!-- The window is a fixed transparent stage; only the pill inside it changes size, so animations never move the window. -->
    <Grid>
        <Border x:Name="Pill" Width="300" CornerRadius="26" Background="#A3080809" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14" Opacity="0"
                RenderTransformOrigin="0.5,0" PreviewMouseWheel="Pill_Wheel">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="0.5" ScaleY="0.5"/>
            </Border.RenderTransform>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#55FFFFFF" Offset="0"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.6"/>
                    <GradientStop Color="#33FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="IslandGlow" BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#1ED760"/>
            </Border.Effect>

            <Grid x:Name="PillClip">
                <Border CornerRadius="26" Opacity="0.32" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.08,0.2" GradientOrigin="0.08,0.2" RadiusX="1.1" RadiusY="1.4">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel>
                    <!-- Thin row: art, title, artist (+ side controls) -->
                    <Grid Height="48" Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Art" Width="32" Height="32" CornerRadius="16" Background="#33FFFFFF"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ArtScale"/>
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel x:Name="TextHost" Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="TextShift"/>
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="TitleText" FontSize="13" FontFamily="{StaticResource UiFontMedium}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border x:Name="SideHost" Grid.Column="2" Width="0" Opacity="0" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" Width="108" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource RoundButton}" Width="30" Height="30" FontSize="12" Margin="2,0"
                                        Content="&#xE892;" Click="Previous_Click"/>
                                <Button x:Name="SidePlay" Style="{StaticResource PlayButton}" Width="34" Height="34" FontSize="14" Margin="2,0"
                                        Content="&#xE769;" Click="Play_Click"/>
                                <Button Style="{StaticResource RoundButton}" Width="30" Height="30" FontSize="12" Margin="2,0"
                                        Content="&#xE893;" Click="Next_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Controls below -->
                    <Border x:Name="BelowHost" Height="0" Opacity="0" ClipToBounds="True">
                        <StackPanel Margin="16,2,16,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource RoundButton}" Width="36" Height="36" Content="&#xE892;" Click="Previous_Click"/>
                                <Button x:Name="BelowPlay" Style="{StaticResource PlayButton}" Width="44" Height="44" Margin="12,0" Content="&#xE769;" Click="Play_Click"/>
                                <Button Style="{StaticResource RoundButton}" Width="36" Height="36" Content="&#xE893;" Click="Next_Click"/>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource PillSlider}" Height="22" Margin="10,0"
                                        ValueChanged="Volume_Changed"/>
                                <TextBlock x:Name="VolumeText" Grid.Column="2" Width="34" Text="0%" FontSize="12" Foreground="White"
                                           VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
